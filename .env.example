# Copy to .env and replace both passwords before starting.
POSTGRES_DB=streetside
POSTGRES_USER=streetside
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
PORT=8080
# Include the exact URL employees use, including port, for local network tablets.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
# Set true behind an HTTPS reverse proxy. Keep false for localhost HTTP development.
COOKIE_SECURE=false
